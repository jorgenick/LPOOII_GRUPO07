<Window x:Class="Vistas.AltaCliente"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ABM de (Clientes)" Height="371" Width="880"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource VentanaConDegradado}">

    <DockPanel Margin="10" Width="839">
        <WrapPanel DockPanel.Dock="Top" HorizontalAlignment="Left" Margin="0,0,0,20">
            <Button x:Name="btnNuevo" Style="{StaticResource BotonRojo}" Click="btnNuevo_Click" ToolTip="Crear un nuevo cliente">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/images/iconos/nuevo.png" Style="{StaticResource IconoBoton}"/>
                    <TextBlock Text="Nuevo" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button x:Name="btnModificar" Style="{StaticResource BotonRojo}" ToolTip="Modificar el cliente seleccionado">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/images/iconos/modificar.png" Style="{StaticResource IconoBoton}"/>
                    <TextBlock Text="Modificar" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button x:Name="btnEliminar" Style="{StaticResource BotonRojo}" ToolTip="Eliminar el cliente seleccionado">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/images/iconos/eliminar.png" Style="{StaticResource IconoBoton}"/>
                    <TextBlock Text="Eliminar" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button x:Name="btnGuardar" Style="{StaticResource BotonAzul}" IsEnabled="False" Click="btnGuardar_Click" ToolTip="Guardar los datos del cliente">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/images/iconos/guardar.png" Style="{StaticResource IconoBoton}"/>
                    <TextBlock Text="Guardar" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button x:Name="btnCancelar" Style="{StaticResource BotonAzul}" IsEnabled="False" Click="btnCancelar_Click" ToolTip="Cancelar la operación en curso">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/images/iconos/cancelar.png" Style="{StaticResource IconoBoton}"/>
                    <TextBlock Text="Cancelar" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button x:Name="btnPrimero" Style="{StaticResource BotonVerde}" ToolTip="Ir al primer cliente">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/images/iconos/primero.png" Style="{StaticResource IconoBoton}"/>
                    <TextBlock Text="Primero" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button x:Name="btnAnterior" Style="{StaticResource BotonVerde}" ToolTip="Ir al cliente anterior">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/images/iconos/anterior.png" Style="{StaticResource IconoBoton}"/>
                    <TextBlock Text="Anterior" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button x:Name="btnSiguiente" Style="{StaticResource BotonVerde}" ToolTip="Ir al cliente siguiente">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/images/iconos/siguiente.png" Style="{StaticResource IconoBoton}"/>
                    <TextBlock Text="Siguiente" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button x:Name="btnUltimo" Style="{StaticResource BotonVerde}" ToolTip="Ir al último cliente">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/images/iconos/ultimo.png" Style="{StaticResource IconoBoton}"/>
                    <TextBlock Text="Último" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </WrapPanel>

        <Button x:Name="btnSalir" DockPanel.Dock="Bottom" Style="{StaticResource BotonSalir}" HorizontalAlignment="Right" Click="btnSalir_Click" ToolTip="Cerrar esta ventana">
            <StackPanel Orientation="Horizontal">
                <Image Source="/images/iconos/salir.png" Style="{StaticResource IconoBoton}"/>
                <TextBlock Text="Salir" VerticalAlignment="Center"/>
            </StackPanel>
        </Button>

        <Grid VerticalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="DNI" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBox x:Name="txtDNI" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Left" IsEnabled="False" Style="{StaticResource TextBoxABM}"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Apellido" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBox x:Name="txtApellido" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Left" IsEnabled="False" Style="{StaticResource TextBoxABM}"/>

            <TextBlock Grid.Row="4" Grid.Column="0" Text="Nombre" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBox x:Name="txtNombre" Grid.Row="4" Grid.Column="1" HorizontalAlignment="Left" IsEnabled="False" Style="{StaticResource TextBoxABM}"/>

            <TextBlock Grid.Row="6" Grid.Column="0" Text="Dirección" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBox x:Name="txtDireccion" Grid.Row="6" Grid.Column="1" HorizontalAlignment="Left" IsEnabled="False" Style="{StaticResource TextBoxABM}"/>
        </Grid>
    </DockPanel>
</Window>