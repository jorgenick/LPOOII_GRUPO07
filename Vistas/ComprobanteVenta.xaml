<Window x:Class="Vistas.ComprobanteVenta"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Venta" Height="500" Width="650">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DocumentViewer x:Name="docViewer" Grid.Row="0"/>
        <Button Content="Imprimir" Grid.Row="1" Click="btnImprimir_Click"
                HorizontalAlignment="Center" Margin="10" Padding="20,5"/>
    </Grid>
</Window>