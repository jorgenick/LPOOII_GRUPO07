<Window x:Class="Vistas.AbmClientes"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:ClasesBase;assembly=ClasesBase"
        Title="AbmClientes" Height="396" Width="672" Loaded="Window_Loaded">
    
    <Window.Resources>
        <ObjectDataProvider
            x:Key="LIST_CLIENTE"
            ObjectType="{x:Type svc:TrabajarClientes}"
            MethodName="TraerClientes">
            
        </ObjectDataProvider>
    </Window.Resources>

    <Canvas Name="canvas_content" DataContext="{Binding Source={StaticResource ResourceKey=LIST_CLIENTE}}" Height="408" Width="652">
        
        <StackPanel Orientation="Horizontal" Height="40" Width="193" Canvas.Left="443" Canvas.Top="12">
            <Button Name="btnFirst" Content="|&lt;" Margin="0 0 10 0" Width="40" Height="23" Click="btnFirst_Click"></Button>
            <Button Name="btnPrevious" Content="&lt;" Margin="0 0 10 0" Width="40" Height="23" Click="btnPrevious_Click"></Button>
            <Button Name="btnNext" Content="&gt;" Margin="0 0 10 0" Width="40" Height="23" Click="btnNext_Click"></Button>
            <Button Name="btnLast" Content="&gt;|" Margin="0 0 10 0" Width="40" Height="23" Click="btnLast_Click"></Button>
        </StackPanel>
        
        <StackPanel Orientation="Horizontal" Canvas.Left="28" Canvas.Top="12" Height="40" Name="stackPanelAcciones" Width="245">
            <Button Content="Nuevo" Height="23" Name="btnNuevo" Width="75" Margin="0 0 10 0" Click="btnNuevo_Click" />
            <Button Content="Modificar" Height="23" Name="btnModificar" Width="75" Margin="0 0 10 0" Click="btnModificar_Click" />
            <Button Content="Eliminar" Height="23" Name="btnEliminar" Width="75" Margin="0 0 10 0" Click="btnEliminar_Click" />
        </StackPanel>
        <StackPanel Height="107" Name="stackPanelLabels" Width="184" Canvas.Left="12" Canvas.Top="95">
            <Label Content="DNI" Height="25" Name="labelDni" Width="175" />
            <Label Content="Apellido" Height="25" Name="lblApellido" Width="182" />
            <Label Content="Nombre" Height="25" Name="lblNombre" Width="182" />
            <Label Content="Dirección" Height="25" Name="lblDireccion" Width="181" />
        </StackPanel>
        
        
        <StackPanel Name="stackPanelInputs" Canvas.Left="397" Canvas.Top="95">
            <TextBox Height="25" Background="Beige" Padding="2" Name="txtDNI" Width="236" 
             Text="{Binding Dni, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,2"/>
            <TextBox Height="25" Background="Beige" Padding="2" Name="txtApellido" Width="231" 
             Text="{Binding Apellido, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,2"/>
            <TextBox Height="25" Background="Beige" Padding="2" Name="txtNombre" Width="235" 
             Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,2"/>
            <TextBox Height="25" Background="Beige" Padding="2" Name="txtDireccion" Width="230" 
             Text="{Binding Direccion, UpdateSourceTrigger=PropertyChanged}"/>
        </StackPanel>
    </Canvas>
    <!--
    <Grid>
        
    </Grid>-->
</Window>
