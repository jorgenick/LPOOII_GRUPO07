<Window x:Class="Vistas.AbmClientes"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:ClasesBase;assembly=ClasesBase"
        Title="AbmClientes" Height="396" Width="672" Loaded="Window_Loaded"
        Style="{StaticResource VentanaConDegradado}">
    
    <Window.Resources>
        <ObjectDataProvider
            x:Key="LIST_CLIENTE"
            ObjectType="{x:Type svc:TrabajarClientes}"
            MethodName="TraerClientes">
            
        </ObjectDataProvider>
    </Window.Resources>

    <Canvas Name="canvas_content" DataContext="{Binding Source={StaticResource ResourceKey=LIST_CLIENTE}}" Height="408" Width="652">

        <!-- Botones de navegacion solo ícono -->
        <StackPanel Orientation="Horizontal" Height="40" Width="200" Canvas.Left="443" Canvas.Top="12">
            <Button Name="btnFirst" Margin="0 0 10 0" Width="40" Height="28" Click="btnFirst_Click" ToolTip="Ir al primer cliente">
                <Image Source="/images/iconos/primero.png" Width="16" Height="16"/>
            </Button>
            <Button Name="btnPrevious" Margin="0 0 10 0" Width="40" Height="28" Click="btnPrevious_Click" ToolTip="Ir al cliente anterior">
                <Image Source="/images/iconos/anterior.png" Width="16" Height="16"/>
            </Button>
            <Button Name="btnNext" Margin="0 0 10 0" Width="40" Height="28" Click="btnNext_Click" ToolTip="Ir al cliente siguiente">
                <Image Source="/images/iconos/siguiente.png" Width="16" Height="16"/>
            </Button>
            <Button Name="btnLast" Margin="0 0 10 0" Width="40" Height="28" Click="btnLast_Click" ToolTip="Ir al último cliente">
                <Image Source="/images/iconos/ultimo.png" Width="16" Height="16"/>
            </Button>
        </StackPanel>

        <!-- Botones de acciones icono y texto -->
        <StackPanel Orientation="Horizontal" Canvas.Left="28" Canvas.Top="12" Height="40" Name="stackPanelAcciones" Width="320">
            <Button Height="28" Name="btnNuevo" Width="95" Margin="0 0 10 0" Click="btnNuevo_Click" ToolTip="Crear un nuevo cliente">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/images/iconos/nuevo.png" Style="{StaticResource IconoBoton}"/>
                    <TextBlock Text="Nuevo" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Height="28" Name="btnModificar" Width="95" Margin="0 0 10 0" Click="btnModificar_Click" ToolTip="Modificar el cliente seleccionado">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/images/iconos/modificar.png" Style="{StaticResource IconoBoton}"/>
                    <TextBlock Text="Modificar" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Height="28" Name="btnEliminar" Width="95" Margin="0 0 10 0" Click="btnEliminar_Click" ToolTip="Eliminar el cliente seleccionado">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/images/iconos/eliminar.png" Style="{StaticResource IconoBoton}"/>
                    <TextBlock Text="Eliminar" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

        </StackPanel>
        <StackPanel Height="107" Name="stackPanelLabels" Width="184" Canvas.Left="12" Canvas.Top="95">
            <Label Content="DNI" Height="25" Name="labelDni" Width="184" />
            <Label Content="Apellido" Height="25" Name="lblApellido" Width="186" />
            <Label Content="Nombre" Height="25" Name="lblNombre" Width="186" />
            <Label Content="Dirección" Height="25" Name="lblDireccion" Width="185" />
        </StackPanel>
        
        
        <StackPanel Name="stackPanelInputs" Canvas.Left="397" Canvas.Top="95">
            <TextBox Height="25" Background="Beige" Padding="2" Name="txtDNI" Width="238" 
             Text="{Binding Dni, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,2"/>
            <TextBox Height="25" Background="Beige" Padding="2" Name="txtApellido" Width="237" 
             Text="{Binding Apellido, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,2"/>
            <TextBox Height="25" Background="Beige" Padding="2" Name="txtNombre" Width="239" 
             Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,2"/>
            <TextBox Height="25" Background="Beige" Padding="2" Name="txtDireccion" Width="238" 
             Text="{Binding Direccion, UpdateSourceTrigger=PropertyChanged}"/>
        </StackPanel>
    </Canvas>
    <!--
    <Grid>
        
    </Grid>-->
</Window>
