<Window x:Class="Vistas.AltaProducto"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ABM de (Productos)" Height="442" Width="880"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource VentanaConDegradado}">

    <DockPanel Margin="10">
        <WrapPanel DockPanel.Dock="Top" HorizontalAlignment="Left" Margin="0,0,0,20" Width="760">
            <Button x:Name="btnNuevo" Style="{StaticResource BotonRojo}" Click="btnNuevo_Click" ToolTip="Crear un nuevo producto">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/images/iconos/nuevo.png" Style="{StaticResource IconoBoton}"/>
                    <TextBlock Text="Nuevo" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button x:Name="btnModificar" Style="{StaticResource BotonRojo}" Click="btnModificar_Click" ToolTip="Modificar el producto seleccionado">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/images/iconos/modificar.png" Style="{StaticResource IconoBoton}"/>
                    <TextBlock Text="Modificar" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button x:Name="btnEliminar" Style="{StaticResource BotonRojo}" Click="btnEliminar_Click" ToolTip="Eliminar el producto seleccionado">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/images/iconos/eliminar.png" Style="{StaticResource IconoBoton}"/>
                    <TextBlock Text="Eliminar" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button x:Name="btnGuardar" Style="{StaticResource BotonAzul}" IsEnabled="False" Click="btnGuardar_Click" ToolTip="Guardar los datos del producto">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/images/iconos/guardar.png" Style="{StaticResource IconoBoton}"/>
                    <TextBlock Text="Guardar" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button x:Name="btnCancelar" Style="{StaticResource BotonAzul}" IsEnabled="False" Click="btnCancelar_Click" ToolTip="Cancelar la operación en curso">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/images/iconos/cancelar.png" Style="{StaticResource IconoBoton}"/>
                    <TextBlock Text="Cancelar" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button x:Name="btnPrimero" Style="{StaticResource BotonVerde}" Click="btnPrimero_Click" ToolTip="Ir al primer producto">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/images/iconos/primero.png" Style="{StaticResource IconoBoton}"/>
                    <TextBlock Text="Primero" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button x:Name="btnAnterior" Style="{StaticResource BotonVerde}" Click="btnAnterior_Click" ToolTip="Ir al producto anterior">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/images/iconos/anterior.png" Style="{StaticResource IconoBoton}"/>
                    <TextBlock Text="Anterior" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button x:Name="btnSiguiente" Style="{StaticResource BotonVerde}" Click="btnSiguiente_Click" ToolTip="Ir al producto siguiente">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/images/iconos/siguiente.png" Style="{StaticResource IconoBoton}"/>
                    <TextBlock Text="Siguiente" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button x:Name="btnUltimo" Style="{StaticResource BotonVerde}" Click="btnUltimo_Click" ToolTip="Ir al último producto">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/images/iconos/ultimo.png" Style="{StaticResource IconoBoton}"/>
                    <TextBlock Text="Último" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Name="button1" Style="{StaticResource BotonVerde}" Click="button1_Click" ToolTip="Ver la lista de estados">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/images/iconos/estados.png" Style="{StaticResource IconoBoton}"/>
                    <TextBlock Text="Estados" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button x:Name="btnVerProductos" Style="{StaticResource BotonVerde}" Click="btnVerProductos_Click" ToolTip="Ver el listado de productos">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/images/iconos/ver.png" Style="{StaticResource IconoBoton}"/>
                    <TextBlock Text="Ver Productos" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </WrapPanel>

        <Button x:Name="btnSalir" DockPanel.Dock="Bottom" Style="{StaticResource BotonSalir}" HorizontalAlignment="Right" Click="btnSalir_Click" ToolTip="Cerrar esta ventana">
            <StackPanel Orientation="Horizontal">
                <Image Source="/images/iconos/salir.png" Style="{StaticResource IconoBoton}"/>
                <TextBlock Text="Salir" VerticalAlignment="Center"/>
            </StackPanel>
        </Button>

        <Grid VerticalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="18"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="18"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="18"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="18"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Cód. Producto" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBox x:Name="txtCodProducto" Text="{Binding Path=CodProducto, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Left" IsEnabled="False" Style="{StaticResource TextBoxABM}"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Categoría" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBox x:Name="txtCategoria" Text="{Binding Path=Categoria, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Left" IsEnabled="False" Style="{StaticResource TextBoxABM}"/>

            <TextBlock Grid.Row="4" Grid.Column="0" Text="Color" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBox x:Name="txtColor" Text="{Binding Path=Color, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" Grid.Row="4" Grid.Column="1" HorizontalAlignment="Left" IsEnabled="False" Style="{StaticResource TextBoxABM}"/>

            <TextBlock Grid.Row="6" Grid.Column="0" Text="Descripción" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBox x:Name="txtDescripcion" Text="{Binding Path=Descripcion, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" Grid.Row="6" Grid.Column="1" HorizontalAlignment="Left" IsEnabled="False" Style="{StaticResource TextBoxABM}"/>

            <TextBlock Grid.Row="8" Grid.Column="0" Text="Precio" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBox x:Name="txtPrecio" Text="{Binding Path=Precio, ValidatesOnDataErrors=True, ValidatesOnExceptions=True, UpdateSourceTrigger=PropertyChanged}" Grid.Row="8" Grid.Column="1" HorizontalAlignment="Left" IsEnabled="False" Style="{StaticResource TextBoxABM}"/>
        </Grid>
    </DockPanel>
</Window>