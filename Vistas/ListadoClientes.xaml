<Window x:Class="Vistas.ListadoClientes"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ListadoClientes" Height="336" Width="445">
    <Grid>
        <DataGrid AutoGenerateColumns="False" CanUserAddRows="False" Loaded="dataGridClientes_Loaded" Name="dataGridClientes">

        <DataGrid.Columns>
                <DataGridTextColumn Header="DNI" Binding="{Binding ClienteDNI}" Width="80"/>
                <DataGridTextColumn Header="Apellido" Binding="{Binding Apellido}" Width="*"/>
                <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="150"/>
                <DataGridTextColumn Header="Dirección" Binding="{Binding Direccion}" Width="150"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
