<Window x:Class="Vistas.ListadoVentas"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Listado de Ventas" Height="420" Width="900"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        Style="{StaticResource VentanaConDegradado}">

    <DockPanel Margin="10">
        <TextBlock DockPanel.Dock="Top" Text="Ventas registradas"
                   FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>

        <Button x:Name="btnSalir" DockPanel.Dock="Bottom" Content="Salir"
                Style="{StaticResource BotonSalir}" HorizontalAlignment="Right"
                Margin="0,10,0,0" Click="btnSalir_Click"/>

        <DataGrid x:Name="dgVentas" AutoGenerateColumns="False"
                  IsReadOnly="True" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Nro. Factura" Binding="{Binding NroFactura}" Width="90"/>
                <DataGridTextColumn Header="Fecha"        Binding="{Binding FechaFactura, StringFormat=dd/MM/yyyy}" Width="90"/>
                <DataGridTextColumn Header="DNI"          Binding="{Binding DNI}"      Width="80"/>
                <DataGridTextColumn Header="Vendedor"     Binding="{Binding Vendedor}" Width="*"/>
                <DataGridTextColumn Header="Producto"     Binding="{Binding Producto}" Width="*"/>
                <DataGridTextColumn Header="Cantidad"     Binding="{Binding Cantidad}" Width="70"/>
                <DataGridTextColumn Header="Precio"       Binding="{Binding Precio, StringFormat=N2}"  Width="90"/>
                <DataGridTextColumn Header="Importe"      Binding="{Binding Importe, StringFormat=N2}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
