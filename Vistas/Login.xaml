<Window x:Class="Vistas.Login"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:control="clr-namespace:Vistas.ControlUsuario"
        Title="Bienvenido - Ingrese Usuario y Contraseña" Height="440" Width="420"
        WindowStartupLocation="CenterScreen"
        Background="#F5EFE6"
        ResizeMode="NoResize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Encabezado -->
        <Border Grid.Row="0" Background="#5C3A21">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="MUEBLERÍA OFICIAL" FontSize="22" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                <TextBlock Text="Sistema de Gestión" FontSize="12" Foreground="#E8D5B7" HorizontalAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Formulario -->
        <Border Grid.Row="1" Background="White" BorderBrush="#D8C3A5" BorderThickness="1"
                CornerRadius="6" Margin="30" Padding="30">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Iniciar Sesión" FontSize="18" FontWeight="Bold"
                           Foreground="#4A3222" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                <control:Login x:Name="login"/>
                <Button x:Name="btnIngresar" Content="Ingresar" Style="{StaticResource BotonPrincipal}"
                        HorizontalAlignment="Stretch" Click="btnclick_onClick"/>

                <TextBlock x:Name="lblMensaje" Margin="0,15,0,0" HorizontalAlignment="Center"
                           FontWeight="Bold" TextWrapping="Wrap" TextAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>