<Window x:Class="Vistas.AcercaDe"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AcercaDe" Height="300" Width="300">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Datos del Grupo -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Grupo N° 07" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center"/>
            <TextBlock Text="Integrantes: Martín Castillo, Riki, [Otros integrantes]" HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- Reproductor de Video -->
        <!-- Source apunta a la carpeta Videos que creaste. LoadedBehavior="Manual" es obligatorio -->
        <MediaElement x:Name="reproductor" Grid.Row="1" LoadedBehavior="Manual" 
                  Source="Recursos\Video\file_example_MP4_480_1_5MG.mp4" 
                  MediaOpened="reproductor_MediaOpened" />

        <!-- Slider de avance -->
        <Slider x:Name="sliderVideo" Grid.Row="2" Margin="0,10,0,10" 
            Thumb.DragStarted="sliderVideo_DragStarted" 
            Thumb.DragCompleted="sliderVideo_DragCompleted"/>

        <!-- Botones de Control -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button x:Name="btnPlay" Content="Play" Click="btnPlay_Click" Width="75" Margin="5"/>
            <Button x:Name="btnPause" Content="Pause" Click="btnPause_Click" Width="75" Margin="5"/>
            <Button x:Name="btnStop" Content="Stop" Click="btnStop_Click" Width="75" Margin="5"/>
        </StackPanel>
    </Grid>
</Window>
