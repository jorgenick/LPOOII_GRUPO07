<Window x:Class="Vistas.AltaProveedor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ABM de Proveedores" Height="320" Width="676"
        WindowStartupLocation="CenterScreen"
        Background="White">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Fila de botones ABM -->
        <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,15">
            <Button x:Name="btnNuevo" Content="Nuevo" Style="{StaticResource BotonRojo}" Click="btnNuevo_Click"/>
            <Button x:Name="btnModificar" Content="Modificar" Style="{StaticResource BotonRojo}"/>
            <Button x:Name="btnEliminar" Content="Eliminar" Style="{StaticResource BotonRojo}"/>
            <Button x:Name="btnGuardar" Content="Guardar" Style="{StaticResource BotonAzul}" IsEnabled="False" Click="btnGuardar_Click"/>
            <Button x:Name="btnCancelar" Content="Cancelar" Style="{StaticResource BotonAzul}" IsEnabled="False" Click="btnCancelar_Click"/>
            <Button x:Name="btnPrimero" Content="Primero" Style="{StaticResource BotonVerde}"/>
            <Button x:Name="btnAnterior" Content="Anterior" Style="{StaticResource BotonVerde}"/>
            <Button x:Name="btnSiguiente" Content="Siguiente" Style="{StaticResource BotonVerde}"/>
            <Button x:Name="btnUltimo" Content="Último" Style="{StaticResource BotonVerde}"/>
        </StackPanel>

        <!-- Campos -->
        <TextBlock Grid.Row="1" Grid.Column="0" Text="CUIT:" VerticalAlignment="Center" Margin="5"/>
        <TextBox x:Name="txtCUIT" Grid.Row="1" Grid.Column="1" Margin="5" HorizontalAlignment="Left" IsEnabled="False" Style="{StaticResource TextBoxABM}"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Razón Social:" VerticalAlignment="Center" Margin="5"/>
        <TextBox x:Name="txtRazonSocial" Grid.Row="2" Grid.Column="1" Margin="5" HorizontalAlignment="Left" IsEnabled="False" Style="{StaticResource TextBoxABM}"/>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Domicilio:" VerticalAlignment="Center" Margin="5"/>
        <TextBox x:Name="txtDomicilio" Grid.Row="3" Grid.Column="1" Margin="5" HorizontalAlignment="Left" IsEnabled="False" Style="{StaticResource TextBoxABM}"/>

        <TextBlock Grid.Row="4" Grid.Column="0" Text="Teléfono:" VerticalAlignment="Center" Margin="5"/>
        <TextBox x:Name="txtTelefono" Grid.Row="4" Grid.Column="1" Margin="5" HorizontalAlignment="Left" IsEnabled="False" Style="{StaticResource TextBoxABM}"/>

        <!-- Salir -->
        <Button x:Name="btnSalir" Grid.Row="6" Grid.Column="1" Content="Salir" Width="90" Height="28"
                HorizontalAlignment="Right" Background="#0033CC" Foreground="White" FontWeight="Bold"
                Click="btnSalir_Click"/>
    </Grid>
</Window>