<Window x:Class="Vistas.AltaProveedor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ABM de Proveedores" Height="243" Width="676"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Fila de botones ABM -->
        <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,15">
            <Button x:Name="btnNuevo" Content="Nuevo" Width="70" Margin="2" Click="btnNuevo_Click"/>
            <Button x:Name="btnModificar" Content="Modificar" Width="70" Margin="2"/>
            <Button x:Name="btnEliminar" Content="Eliminar" Width="70" Margin="2"/>
            <Button x:Name="btnGuardar" Content="Guardar" Width="70" Margin="2" IsEnabled="False" Click="btnGuardar_Click"/>
            <Button x:Name="btnCancelar" Content="Cancelar" Width="70" Margin="2" IsEnabled="False" Click="btnCancelar_Click"/>
            <Button x:Name="btnPrimero" Content="Primero" Width="60" Margin="2"/>
            <Button x:Name="btnAnterior" Content="Anterior" Width="60" Margin="2"/>
            <Button x:Name="btnSiguiente" Content="Siguiente" Width="65" Margin="2"/>
            <Button x:Name="btnUltimo" Content="Último" Width="60" Margin="2"/>
        </StackPanel>

        <!-- Campos -->
        <TextBlock Grid.Row="1" Grid.Column="0" Text="CUIT:" VerticalAlignment="Center" Margin="5"/>
        <TextBox x:Name="txtCUIT" Grid.Row="1" Grid.Column="1" Margin="5" IsEnabled="False"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Razón Social:" VerticalAlignment="Center" Margin="5"/>
        <TextBox x:Name="txtRazonSocial" Grid.Row="2" Grid.Column="1" Margin="5" IsEnabled="False"/>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Domicilio:" VerticalAlignment="Center" Margin="5"/>
        <TextBox x:Name="txtDomicilio" Grid.Row="3" Grid.Column="1" Margin="5" IsEnabled="False"/>

        <TextBlock Grid.Row="4" Grid.Column="0" Text="Teléfono:" VerticalAlignment="Center" Margin="5"/>
        <TextBox x:Name="txtTelefono" Grid.Row="4" Grid.Column="1" Margin="5" IsEnabled="False"/>

        <!-- Salir -->
        <Button x:Name="btnSalir" Grid.Row="6" Grid.Column="1" Content="Salir" Width="80"
                HorizontalAlignment="Right" Click="btnSalir_Click"/>
    </Grid>
</Window>