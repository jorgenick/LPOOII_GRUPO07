<Window x:Class="Vistas.AltaProveedor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ABM de Proveedores" Height="320" Width="880"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource VentanaConDegradado}">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Fila de botones ABM -->
        <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,15">
            <Button x:Name="btnNuevo" Style="{StaticResource BotonRojo}" Click="btnNuevo_Click" ToolTip="Crear un nuevo proveedor">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/images/iconos/nuevo.png" Style="{StaticResource IconoBoton}"/>
                    <TextBlock Text="Nuevo" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button x:Name="btnModificar" Style="{StaticResource BotonRojo}" ToolTip="Modificar el proveedor seleccionado">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/images/iconos/modificar.png" Style="{StaticResource IconoBoton}"/>
                    <TextBlock Text="Modificar" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button x:Name="btnEliminar" Style="{StaticResource BotonRojo}" ToolTip="Eliminar el proveedor seleccionado">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/images/iconos/eliminar.png" Style="{StaticResource IconoBoton}"/>
                    <TextBlock Text="Eliminar" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button x:Name="btnGuardar" Style="{StaticResource BotonAzul}" IsEnabled="False" Click="btnGuardar_Click" ToolTip="Guardar los datos del proveedor">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/images/iconos/guardar.png" Style="{StaticResource IconoBoton}"/>
                    <TextBlock Text="Guardar" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button x:Name="btnCancelar" Style="{StaticResource BotonAzul}" IsEnabled="False" Click="btnCancelar_Click" ToolTip="Cancelar la operación en curso">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/images/iconos/cancelar.png" Style="{StaticResource IconoBoton}"/>
                    <TextBlock Text="Cancelar" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button x:Name="btnPrimero" Style="{StaticResource BotonVerde}" ToolTip="Ir al primer proveedor">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/images/iconos/primero.png" Style="{StaticResource IconoBoton}"/>
                    <TextBlock Text="Primero" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button x:Name="btnAnterior" Style="{StaticResource BotonVerde}" ToolTip="Ir al proveedor anterior">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/images/iconos/anterior.png" Style="{StaticResource IconoBoton}"/>
                    <TextBlock Text="Anterior" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button x:Name="btnSiguiente" Style="{StaticResource BotonVerde}" ToolTip="Ir al proveedor siguiente">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/images/iconos/siguiente.png" Style="{StaticResource IconoBoton}"/>
                    <TextBlock Text="Siguiente" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button x:Name="btnUltimo" Style="{StaticResource BotonVerde}" ToolTip="Ir al último proveedor">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/images/iconos/ultimo.png" Style="{StaticResource IconoBoton}"/>
                    <TextBlock Text="Último" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- Campos -->
        <TextBlock Grid.Row="1" Grid.Column="0" Text="CUIT:" VerticalAlignment="Center" Margin="5"/>
        <TextBox x:Name="txtCUIT" Grid.Row="1" Grid.Column="1" Margin="5" HorizontalAlignment="Left" IsEnabled="False" Style="{StaticResource TextBoxABM}"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Razón Social:" VerticalAlignment="Center" Margin="5"/>
        <TextBox x:Name="txtRazonSocial" Grid.Row="2" Grid.Column="1" Margin="5" HorizontalAlignment="Left" IsEnabled="False" Style="{StaticResource TextBoxABM}"/>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Domicilio:" VerticalAlignment="Center" Margin="5"/>
        <TextBox x:Name="txtDomicilio" Grid.Row="3" Grid.Column="1" Margin="5" HorizontalAlignment="Left" IsEnabled="False" Style="{StaticResource TextBoxABM}"/>

        <TextBlock Grid.Row="4" Grid.Column="0" Text="Teléfono:" VerticalAlignment="Center" Margin="5"/>
        <TextBox x:Name="txtTelefono" Grid.Row="4" Grid.Column="1" Margin="5" HorizontalAlignment="Left" IsEnabled="False" Style="{StaticResource TextBoxABM}"/>

        <!-- Salir -->
        <Button x:Name="btnSalir" Grid.Row="6" Grid.Column="1" Style="{StaticResource BotonSalir}" Click="btnSalir_Click" ToolTip="Cerrar esta ventana">
            <StackPanel Orientation="Horizontal">
                <Image Source="/images/iconos/salir.png" Style="{StaticResource IconoBoton}"/>
                <TextBlock Text="Salir" VerticalAlignment="Center"/>
            </StackPanel>
        </Button>
        </Grid>
</Window>