<Window x:Class="Vistas.VistaPreviaClientes"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vista previa de impresión" Height="400" Width="560"
        WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <FlowDocumentReader Grid.Row="0">
            <FlowDocument Name="DocMain">
                <Paragraph FontSize="18" FontWeight="Bold">Listado de Clientes</Paragraph>
                <BlockUIContainer>
                    <ListView Name="lvClientes">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="DNI" DisplayMemberBinding="{Binding Dni}" Width="90" />
                                <GridViewColumn Header="Apellido" DisplayMemberBinding="{Binding Apellido}" Width="130" />
                                <GridViewColumn Header="Nombre" DisplayMemberBinding="{Binding Nombre}" Width="130" />
                                <GridViewColumn Header="Dirección" DisplayMemberBinding="{Binding Direccion}" Width="200" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </BlockUIContainer>
            </FlowDocument>
        </FlowDocumentReader>

        <Button Grid.Row="1" Name="btnImprimir" Content="Imprimir" Width="100" Height="25"
                Margin="0,8,0,8" HorizontalAlignment="Center" Click="btnImprimir_Click" />
    </Grid>
</Window>
