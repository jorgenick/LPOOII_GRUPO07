<Window x:Class="Vistas.Presentacion"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mueblería" Height="350" Width="550"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="NoResize"
        Loaded="Window_Loaded" MouseDown="Window_MouseDown">
    <Grid Background="#FF3E2723">
        <MediaElement x:Name="reproductor"
                      LoadedBehavior="Manual"
                      UnloadedBehavior="Stop"
                      MediaEnded="reproductor_MediaEnded"
                      MediaFailed="reproductor_MediaFailed" />
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="Bienvenido a Muebleria Oficial" Foreground="White" FontSize="48" FontWeight="Bold" 
                       TextWrapping="Wrap" TextAlignment="Center" Width="480"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="Grupo 07" Foreground="#FFD7CCC8" FontSize="20"
                       HorizontalAlignment="Center" Margin="0,10,0,30" Height="37" Width="94" />
            <TextBlock Text="Click para continuar" Foreground="#FFBCAAA4" FontSize="11" Margin="0,15,0,0" Height="35" Width="144" TextAlignment="Center" />
        </StackPanel>
    </Grid>
</Window>