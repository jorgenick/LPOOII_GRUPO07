<Window x:Class="Vistas.MenuPrincipal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bienvenido Menu Principal" Height="420" Width="520"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Window.Background>
        <ImageBrush ImageSource="images/principal_window_image.jpg" Stretch="UniformToFill"/>
    </Window.Background>

    <Grid Margin="30">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <Border Background="#5C3A21" CornerRadius="10" Padding="14,6"
                    HorizontalAlignment="Center" Margin="0,0,0,25">
                <Label x:Name="lblRol" Content="Bienvenido" Foreground="White" FontWeight="Bold" FontSize="13" Padding="0"/>
            </Border>

            <UniformGrid Columns="2" Rows="2">
                <Button x:Name="btnClientes" Content="Alta de Clientes" Style="{StaticResource BotonMenu}" Click="button1_Click"/>
                <Button x:Name="btnProvedor" Content="Alta de Proveedores" Style="{StaticResource BotonMenu}" Click="btnProvedor_Click"/>
                <Button x:Name="btnProducto" Content="Alta de Productos" Style="{StaticResource BotonMenu}" Click="btnProducto_Click"/>
                <Button x:Name="btnVendedor" Content="Alta de Vendedores" Style="{StaticResource BotonMenu}" Click="btnVendedor_Click"/>
            </UniformGrid>
        </StackPanel>
        <Button Content="Cerrar Sesion" Height="23" HorizontalAlignment="Left" Margin="352,-25,0,0" Name="button1" VerticalAlignment="Top" Width="86" Click="btn_CerrarSesion" Foreground="#FFEFEFEF" FontWeight="Bold" FontSize="10">
            <Button.BorderBrush>
                <LinearGradientBrush EndPoint="1,0.5" StartPoint="0,0.5">
                    <GradientStop Color="Black" Offset="0" />
                    <GradientStop Color="White" Offset="1" />
                </LinearGradientBrush>
            </Button.BorderBrush>
            <Button.Background>
                <LinearGradientBrush EndPoint="1,0.5" StartPoint="0,0.5">
                    <GradientStop Color="Black" Offset="0" />
                    <GradientStop Color="#FFFC7474" Offset="1" />
                </LinearGradientBrush>
            </Button.Background>
        </Button>
    </Grid>
</Window>